<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

  <LinearLayout
      android:orientation="horizontal"
      android:layout_width="fill_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:padding="4dp">
    <TextView
        android:id="@+id/fp_path"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:singleLine="true"
        android:ellipsize="start" />
    <ImageButton
        android:id="@+id/fp_up"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="0dp"
        android:src="@android:drawable/ic_menu_revert"
        android:scaleType="center"
        android:background="@android:drawable/btn_default"
        android:contentDescription="@string/folder_up" />
    <ImageButton
        android:id="@+id/fp_new_folder"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="0dp"
        android:src="@android:drawable/ic_menu_add"
        android:scaleType="center"
        android:background="@android:drawable/btn_default"
        android:contentDescription="@string/folder_new" />
  </LinearLayout>

  <ListView
      android:id="@+id/fp_list"
      android:layout_width="fill_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />

  <LinearLayout
      android:orientation="horizontal"
      android:layout_width="fill_parent"
      android:layout_height="wrap_content">
    <Button
        android:id="@+id/fp_cancel"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:text="@string/cancel" />
    <Button
        android:id="@+id/fp_select"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:text="@string/folder_select" />
  </LinearLayout>
</LinearLayout>
